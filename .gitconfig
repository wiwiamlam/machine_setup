[user]
	email = wiwiamlam@gmail.com
	name = William Lam
[core]
	editor = nvim
	abbrev = 12
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true  # use n and N to move between diff sections
	dark = true      # or light = true, or omit for auto-detection
	#side-by-side = true
	line-numbers = true
	file-style = white bold
	hunk-header-style = omit
	hunk-header-decoration-style = white ul
	file-decoration-style = yellow ul ol
	hunk-header-file-style = white
	line-numbers-left-style = white bold
	line-numbers-right-style = white bold
	line-numbers-zero-style = "#767676"

